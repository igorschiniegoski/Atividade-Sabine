@startuml caso-de-uso-consultas
' sgp - modulo de consultas e relatorios - equipe 8
!include _estilo.puml
left to right direction

actor "usuario" as USR
actor "administrador" as ADM

rectangle "sgp - consultas e relatorios" {
  usecase "UC19\nconsultar historico\nde atendimentos" as UC19 #e8f0f8
  usecase "UC20\ngerar relatorio de\ndesempenho do prestador" as UC20 #e8f0f8
  usecase "UC21\ngerar relatorio de\nservicos por periodo" as UC21 #f4f7fa
}

USR <|-- ADM
USR -- UC19
ADM -- UC20
ADM -- UC21

UC24 ..> UC20 : <<extend>>
UC24 ..> UC21 : <<extend>>

note bottom of UC19
  cada perfil enxerga apenas
  as ordens sob sua
  responsabilidade (RNF02)
end note

legend right
  <b>prioridade (moscow)</b>
  |<back:#e8f0f8>       </back>| should have |
  |<back:#f4f7fa>       </back>| could have |
endlegend
@enduml
