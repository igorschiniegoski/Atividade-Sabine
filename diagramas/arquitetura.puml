@startuml arquitetura
' sgp - diagrama de arquitetura - equipe 8
' versao 1.1 (20/10): mostra so o que ja existe no codigo. storage e vercel voltam quando forem usados
!include _estilo.puml
skinparam ranksep 40
skinparam nodesep 30
skinparam componentStyle rectangle
skinparam component {
  BorderColor #1f4e79
  BackgroundColor #eef3f8
  FontColor #1f2328
}
skinparam database {
  BorderColor #1f4e79
  BackgroundColor #eef3f8
  FontColor #1f2328
}

title arquitetura atual - sgp\n<size:11>monolito em camadas, situacao da entrega de 20/10/2026

actor "administrador" as ADM

rectangle "navegador\nchrome, edge ou firefox" as NAV #f4f7fb

ADM --> NAV

rectangle "next.js 15 na pasta sistema/\nnpm run dev, porta 3000" as APP {
  component "camada de apresentacao\ntelas em react 19 com tailwind\napp/login e app/(admin)" as C1
  component "camada de aplicacao\nserver actions, middleware e sessao do auth.js,\nexigirPerfil e validacao com zod" as C2
  component "camada de dominio (lib/dominio)\nRN10 cpf e cnpj, RNF12 bloqueio do login.\nas demais regras entram com as proximas telas" as C3
  component "camada de acesso a dados\nprisma orm 6 e migracões" as C4

  C1 --> C2 : envio do formulario\n(server action)
  C2 --> C3 : delega a decisao\nde negocio
  C3 --> C4 : pede e grava\nos dados
}

database "postgresql 18 local\nembedded-postgres, porta 5433\n14 tabelas do modelo logico" as DB

NAV --> C1 : http
C4 --> DB : sql

note right of C2
  RNF02 - a permissao é decidida aqui,
  nunca na tela. toda pagina e toda action
  chamam exigirPerfil antes de qualquer coisa
end note

legend bottom
  <b>por que monolito</b>
  um unico dominio, um time de dois integrantes e uma base de dados so.
  dividir em microsservicos acrescentaria deploy e rede sem resolver nenhum problema do projeto.
  <b>o que ainda nao aparece</b>
  prestador e cliente ainda nao tem tela. o storage de arquivos entra com o RF07
  e a publicacao na vercel com banco gerenciado esta prevista para 06/11.
endlegend

@enduml
